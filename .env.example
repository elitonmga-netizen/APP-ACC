# Demo é explícito; no modo api falhas nunca voltam silenciosamente aos mocks.
VITE_DATA_MODE=demo
VITE_API_URL=http://localhost:3001
PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=backend/data/acc.sqlite
# Primeiro administrador: use apenas durante a inicialização inicial; remova depois.
ADMIN_EMAIL=
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
# Resend; chave apenas no backend. Configure o domínio e o DNS no painel do provedor.
RESEND_API_KEY=
EMAIL_FROM=ACC Climatização <no-reply@conta.seudominio.com.br>
APP_PUBLIC_URL=http://localhost:5173
# NODE_ENV=production ativa cookies Secure; produção exige HTTPS.
# Para criar o administrador, defina ADMIN_EMAIL, ADMIN_NAME e ADMIN_PASSWORD
# temporariamente no terminal. Não salve senhas neste arquivo.
