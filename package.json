{
  "name": "app-acc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node backend/bootstrap-admin.mjs && node backend/server.mjs",
    "dev:api": "node --env-file-if-exists=.env backend/server.mjs",
    "admin:create": "node --env-file-if-exists=.env backend/create-admin.mjs",
    "db:seed": "node --env-file-if-exists=.env backend/seed.mjs",
    "test": "node --test backend/*.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "pdfkit": "0.17.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.12.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "5.4.10"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}

